# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Nothing here is read by the browser:
# every value is server-side only, and no key is ever exposed to the client.
# ---------------------------------------------------------------------------

# Postgres. Prisma 7 reads this through prisma7.config.ts.
# Local option:  npx prisma dev
# Hosted option: Supabase (see docs/supabase-setup.md)
#
# This must be a postgresql:// connection string, NOT a project API URL.
# On Supabase: Connect -> Session pooler (port 5432), which works for both
# migrations and the running app. The https://<ref>.supabase.co address is the
# REST endpoint for supabase-js and Prisma cannot use it.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Copy the host from the dashboard; the aws-N prefix is assigned per project
# and is not derivable from the region. A wrong prefix fails as
# "tenant/user postgres.<ref> not found", which looks like a bad password.
# Percent-encode reserved characters in the password: # -> %23, @ -> %40.
#
# Why one URL and not a pooled/direct pair: Prisma 7 moved the datasource into
# prisma7.config.ts, whose Datasource type is { url, shadowDatabaseUrl } — it
# has no `directUrl`. The transaction pooler (6543) cannot run migrations, so a
# 6543 DATABASE_URL would need a direct URL Prisma 7 has nowhere to put. The
# session pooler on 5432 serves both, and is IPv4 — the direct
# db.<ref>.supabase.co:5432 host is IPv6-only without the paid add-on.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase. Used for Postgres (above) and for Storage (meal photos, §4).
#
# Auth is Better Auth, NOT Supabase Auth — see docs/supabase-setup.md for why.
# That has one consequence worth knowing: auth.uid() is always null in this
# project, so Storage RLS policies keyed on it can never match. The
# `meal-photos` bucket is private with no anon/authenticated grant at all, and
# every read and write goes through the server with the service-role key.
# ---------------------------------------------------------------------------

# Project REST endpoint: https://<ref>.supabase.co
# Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Server-side only. Bypasses RLS, so it must never reach the browser: it is
# deliberately NOT prefixed NEXT_PUBLIC_.
# Dashboard -> Project Settings -> API Keys -> service_role (click Reveal)
SUPABASE_SERVICE_ROLE_KEY=

# The browser does not talk to Supabase in this build — photo uploads are
# proxied through our own route handler so the bucket stays private and no
# Supabase credential is shipped to the client. These two are here only for a
# future client-side upload path; leaving them empty changes nothing today.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Session signing, and the signing key for the age-gate and demo cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own origin. OAuth callbacks and email links are built from it.
BETTER_AUTH_URL=http://localhost:3000

# Protects POST /api/cron/snapshot and POST /api/cron/reminders, which write
# for every user. Sent as: Authorization: Bearer ${CRON_SECRET}
# Unset means those endpoints are CLOSED (503), not open.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# A second Postgres for the test suite. `prisma migrate reset` is run against
# this one, so it must never point at the database above.
DATABASE_URL_TEST=

# Google sign-in. Optional — the Google button is hidden when these are unset.
# Authorised redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email: verification, password reset, reminders.
# Optional in development — without it, emails print to the terminal instead.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=

# The twin's AI. Server-side only. Phase 4.
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Market data for Finance -> Investments. All optional: with none of these set
# the app uses NullPriceProvider, holdings are entered by hand, and the UI says
# "Live prices: not connected". Quotes are delayed and labelled as such —
# tracking only, never advice.
# ---------------------------------------------------------------------------

# Stocks (NSE/BSE) via Twelve Data. Free tier ~800 requests/day, 8/min.
# Sign up at https://twelvedata.com, verify email, key is on the dashboard.
# Symbols look like RELIANCE:NSE. Cache hard — the daily cap is easy to hit.
TWELVE_DATA_API_KEY=

# Indian mutual-fund NAV comes from https://api.mfapi.in — AMFI-sourced, no
# key, no signup, no rate limit. There is deliberately no env var for it.
# Fixed deposits are computed locally by fdMaturity(); no API either.

# Photo nutrition via a specialist food API instead of Gemini vision.
# Only needed if the food-vision provider is switched to LogMeal.
LOGMEAL_API_KEY=

# Cross-browser runs. The BrowserStack job is skipped when these are unset.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
